    <script>
        // Global variables
        const APPS_SCRIPT_URL = 'YOUR_APPS_SCRIPT_WEB_APP_URL_HERE';
        let currentMindMap = null;
        let currentClass = null;
        let currentSubject = null;
        let currentTopic = null;
        let isDarkMode = false;
        let selectedNode = null;
        
        // Sample data structure (will be replaced with API calls)
        const sampleData = {
            classes: {
                5: {
                    name: 'Class 5',
                    subjects: ['Bengali', 'English', 'Mathematics', 'Science', 'Social Science']
                },
                9: {
                    name: 'Class 9',
                    subjects: ['Bengali', 'English', 'Mathematics', 'Physical Science', 'Life Science', 'History', 'Geography']
                },
                10: {
                    name: 'Class 10',
                    subjects: ['Bengali', 'English', 'Mathematics', 'Physical Science', 'Life Science', 'History', 'Geography']
                },
                '11science': {
                    name: 'Class 11 (Science)',
                    subjects: ['Physics', 'Chemistry', 'Mathematics', 'Biology', 'Computer Science']
                },
                '12science': {
                    name: 'Class 12 (Science)',
                    subjects: ['Physics', 'Chemistry', 'Mathematics', 'Biology', 'Computer Science']
                }
            },
            topics: {
                'Mathematics': ['Algebra', 'Geometry', 'Trigonometry', 'Statistics'],
                'Physics': ['Mechanics', 'Thermodynamics', 'Optics', 'Electricity'],
                'Biology': ['Cell Biology', 'Genetics', 'Ecology', 'Human Physiology']
            }
        };

        // Initialize neural lines
        function initNeuralLines() {
            const container = document.getElementById('neuralLines');
            const cards = document.querySelectorAll('.class-card-mind');
            
            cards.forEach((card, index) => {
                const line = document.createElement('div');
                line.className = 'neural-line';
                line.style.animationDelay = `${index * 0.1}s`;
                container.appendChild(line);
            });
        }

        // Select class
        function selectClass(classId) {
            currentClass = classId;
            const className = sampleData.classes[classId]?.name || `Class ${classId}`;
            
            document.querySelector('.brain-container').parentElement.style.display = 'none';
            document.getElementById('subjectSection').classList.remove('hidden');
            document.getElementById('selectedClassName').textContent = className;
            
            loadSubjects(classId);
        }

        // Load subjects
        function loadSubjects(classId) {
            const grid = document.getElementById('subjectsGrid');
            const subjects = sampleData.classes[classId]?.subjects || [];
            
            grid.innerHTML = subjects.map((subject, index) => `
                <div class="class-card-mind scroll-reveal scroll-reveal-delay-${(index % 3) + 1}" onclick="selectSubject('${subject}')">
                    <div class="text-2xl font-bold mb-2">${subject}</div>
                    <div class="text-sm text-neutral-400">View topics</div>
                </div>
            `).join('');
        }

        // Select subject
        function selectSubject(subject) {
            currentSubject = subject;
            
            document.getElementById('subjectSection').classList.add('hidden');
            document.getElementById('topicSection').classList.remove('hidden');
            document.getElementById('selectedSubjectName').textContent = subject;
            
            loadTopics(subject);
        }

        // Load topics
        function loadTopics(subject) {
            const grid = document.getElementById('topicsGrid');
            const topics = sampleData.topics[subject] || ['Topic 1', 'Topic 2', 'Topic 3'];
            
            grid.innerHTML = topics.map((topic, index) => `
                <div class="class-card-mind scroll-reveal scroll-reveal-delay-${(index % 2) + 1}" onclick="selectTopic('${topic}')">
                    <div class="text-xl font-bold mb-2">${topic}</div>
                    <div class="text-sm text-neutral-400">View mind map</div>
                </div>
            `).join('');
        }

        // Select topic
        function selectTopic(topic) {
            currentTopic = topic;
            
            document.getElementById('topicSection').classList.add('hidden');
            document.getElementById('viewerSection').classList.remove('hidden');
            
            loadMindMap(currentClass, currentSubject, topic);
        }

        // Load mind map from Google Sheet
        async function loadMindMap(classId, subject, topic) {
            try {
                const response = await fetch(`${APPS_SCRIPT_URL}?action=getAll`);
                const data = await response.json();
                
                if(data.success) {
                    const mindmap = data.data.find(m => 
                        m.class == classId && m.subject === subject && m.topic === topic
                    );
                    
                    if(mindmap) {
                        currentMindMap = mindmap.mindmapData;
                        renderMindMap();
                    } else {
                        // Create sample mind map if not exists
                        createSampleMindMap();
                    }
                }
            } catch(error) {
                console.error('Error loading mind map:', error);
                createSampleMindMap();
            }
        }

        // Create sample mind map
        function createSampleMindMap() {
            currentMindMap = {
                id: 'root',
                text: topic,
                children: [
                    {
                        id: 'child1',
                        text: 'Key Concept 1',
                        children: [
                            { id: 'gc1', text: 'Detail 1.1', children: [] },
                            { id: 'gc2', text: 'Detail 1.2', children: [] }
                        ]
                    },
                    {
                        id: 'child2',
                        text: 'Key Concept 2',
                        children: [
                            { id: 'gc3', text: 'Detail 2.1', children: [] },
                            { id: 'gc4', text: 'Detail 2.2', children: [] }
                        ]
                    }
                ],
                styles: {
                    fontSize: 16,
                    color: '#667eea',
                    bold: true
                }
            };
            
            renderMindMap();
        }

        // Render mind map
        function renderMindMap() {
            const canvas = document.getElementById('mindmapCanvas');
            canvas.innerHTML = '';
            
            const centerX = canvas.offsetWidth / 2;
            const centerY = canvas.offsetHeight / 2;
            
            // Render root node
            renderNode(currentMindMap, centerX, centerY, 0, 0, canvas);
            
            // Render connectors
            renderConnectors(currentMindMap, centerX, centerY, 0, 0, canvas);
        }

        // Render individual node
        function renderNode(node, x, y, level, angle, canvas) {
            const nodeDiv = document.createElement('div');
            nodeDiv.className = `mindmap-node ${level === 0 ? 'root' : level === 1 ? 'child' : 'grandchild'}`;
            nodeDiv.textContent = node.text;
            nodeDiv.style.left = `${x}px`;
            nodeDiv.style.top = `${y}px`;
            nodeDiv.style.transform = 'translate(-50%, -50%)';
            
            // Apply styles
            if(node.styles) {
                nodeDiv.style.fontSize = `${node.styles.fontSize}px`;
                nodeDiv.style.background = `linear-gradient(135deg, ${node.styles.color} 0%, ${node.styles.color}dd 100%)`;
                if(node.styles.bold) nodeDiv.style.fontWeight = '700';
                if(node.styles.italic) nodeDiv.style.fontStyle = 'italic';
                if(node.styles.underline) nodeDiv.style.textDecoration = 'underline';
            }
            
            nodeDiv.onclick = () => editNode(node);
            
            // Collapse/expand functionality
            if(node.children && node.children.length > 0) {
                const toggleBtn = document.createElement('button');
                toggleBtn.textContent = node.collapsed ? '+' : '−';
                toggleBtn.className = 'absolute -right-2 -top-2 w-6 h-6 bg-yellow-500 text-black rounded-full text-xs font-bold';
                toggleBtn.onclick = (e) => {
                    e.stopPropagation();
                    node.collapsed = !node.collapsed;
                    renderMindMap();
                };
                nodeDiv.appendChild(toggleBtn);
            }
            
            canvas.appendChild(nodeDiv);
            
            // Render children if not collapsed
            if(node.children && !node.collapsed) {
                const angleStep = (2 * Math.PI) / node.children.length;
                const radius = level === 0 ? 200 : 150;
                
                node.children.forEach((child, index) => {
                    const childAngle = angle + index * angleStep;
                    const childX = x + Math.cos(childAngle) * radius;
                    const childY = y + Math.sin(childAngle) * radius;
                    
                    renderNode(child, childX, childY, level + 1, childAngle, canvas);
                });
            }
        }

        // Render connectors
        function renderConnectors(node, parentX, parentY, level, parentAngle, canvas) {
            if(!node.children || node.collapsed) return;
            
            const angleStep = (2 * Math.PI) / node.children.length;
            const radius = level === 0 ? 200 : 150;
            
            node.children.forEach((child, index) => {
                const childAngle = parentAngle + index * angleStep;
                const childX = parentX + Math.cos(childAngle) * radius;
                const childY = parentY + Math.sin(childAngle) * radius;
                
                const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                svg.style.position = 'absolute';
                svg.style.width = '100%';
                svg.style.height = '100%';
                svg.style.pointerEvents = 'none';
                
                const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                line.setAttribute('x1', parentX);
                line.setAttribute('y1', parentY);
                line.setAttribute('x2', childX);
                line.setAttribute('y2', childY);
                line.setAttribute('class', 'mindmap-connector');
                
                svg.appendChild(line);
                canvas.appendChild(svg);
                
                renderConnectors(child, childX, childY, level + 1, childAngle, canvas);
            });
        }

        // Edit node
        function editNode(node) {
            selectedNode = node;
            document.getElementById('editText').value = node.text;
            document.getElementById('editFontSize').value = node.styles?.fontSize || 16;
            document.getElementById('editColor').value = node.styles?.color || '#667eea';
            
            document.getElementById('editModal').classList.add('active');
        }

        // Save node edit
        function saveNodeEdit() {
            if(!selectedNode) return;
            
            selectedNode.text = document.getElementById('editText').value;
            selectedNode.styles = {
                fontSize: parseInt(document.getElementById('editFontSize').value),
                color: document.getElementById('editColor').value,
                bold: document.getElementById('editBold').classList.contains('active'),
                italic: document.getElementById('editItalic').classList.contains('active'),
                underline: document.getElementById('editUnderline').classList.contains('active')
            };
            
            closeEditModal();
            renderMindMap();
            
            // Save to Google Sheet
            saveMindMapToSheet();
        }

        // Save mind map to sheet
        async function saveMindMapToSheet() {
            try {
                const params = new URLSearchParams({
                    action: 'update',
                    id: currentMindMap.id,
                    mindmapData: JSON.stringify(currentMindMap)
                });
                
                await fetch(`${APPS_SCRIPT_URL}?${params}`);
            } catch(error) {
                console.error('Error saving:', error);
            }
        }

        // Toggle dark mode
        document.getElementById('toggleMode').onclick = () => {
            isDarkMode = !isDarkMode;
            document.getElementById('mindmapCanvas').classList.toggle('dark-mode', isDarkMode);
        };

        // Collapse all nodes
        document.getElementById('collapseAll').onclick = () => {
            function collapseAll(node) {
                node.collapsed = true;
                if(node.children) {
                    node.children.forEach(collapseAll);
                }
            }
            
            collapseAll(currentMindMap);
            currentMindMap.collapsed = false; // Keep root expanded
            renderMindMap();
        };

        // Create mind map modal
        document.getElementById('createBtn').onclick = () => {
            document.getElementById('createModal').classList.add('active');
        };

        // Verify password
        function verifyPassword() {
            const password = document.getElementById('password').value;
            if(password === 'mindmap0') {
                document.getElementById('passwordSection').classList.add('hidden');
                document.getElementById('createForm').classList.remove('hidden');
            } else {
                alert('Wrong password!');
            }
        }

        // Close modals
        function closeCreateModal() {
            document.getElementById('createModal').classList.remove('active');
            document.getElementById('passwordSection').classList.remove('hidden');
            document.getElementById('createForm').classList.add('hidden');
            document.getElementById('password').value = '';
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.remove('active');
            selectedNode = null;
        }

        // Create empty mind map
        function createEmptyMindMap() {
            const classId = document.getElementById('newClass').value;
            const subject = document.getElementById('newSubject').value;
            const topic = document.getElementById('newTopic').value;
            
            if(!classId || !subject || !topic) {
                alert('Please fill all fields');
                return;
            }
            
            currentClass = classId;
            currentSubject = subject;
            currentTopic = topic;
            
            closeCreateModal();
            
            document.getElementById('topicSection').classList.add('hidden');
            document.getElementById('viewerSection').classList.remove('hidden');
            
            createSampleMindMap();
        }

        // File upload handler
        document.getElementById('svgFile').onchange = (e) => {
            const file = e.target.files[0];
            if(!file) return;
            
            const reader = new FileReader();
            reader.onload = (event) => {
                const content = event.target.result;
                
                if(file.name.endsWith('.svg')) {
                    parseSVGFile(content);
                } else if(file.name.endsWith('.md')) {
                    parseMarkdownFile(content);
                }
            };
            
            reader.readAsText(file);
        };

        // Parse SVG file
        function parseSVGFile(svgContent) {
            const parser = new DOMParser();
            const svg = parser.parseFromString(svgContent, 'image/svg+xml');
            
            currentMindMap = {
                id: 'root',
                text: 'Uploaded Mind Map',
                children: [],
                styles: { fontSize: 16, color: '#667eea' }
            };
            
            // Extract text elements
            const texts = svg.querySelectorAll('text');
            texts.forEach((text, index) => {
                currentMindMap.children.push({
                    id: `node_${index}`,
                    text: text.textContent,
                    children: [],
                    styles: { fontSize: 14, color: '#4facfe' }
                });
            });
            
            renderMindMap();
            saveMindMapToSheet();
        }

        // Parse Markdown file
        function parseMarkdownFile(mdContent) {
            const lines = mdContent.split('\n');
            const root = {
                id: 'root',
                text: lines[0].replace('# ', '').trim(),
                children: [],
                styles: { fontSize: 20, color: '#667eea', bold: true }
            };
            
            let currentLevel = [root];
            
            for(let i = 1; i < lines.length; i++) {
                const line = lines[i].trim();
                if(!line) continue;
                
                const match = line.match(/^(#+)\s+(.+)$/);
                if(match) {
                    const level = match[1].length;
                    const text = match[2];
                    
                    const node = {
                        id: `node_${i}`,
                        text: text,
                        children: [],
                        styles: { 
                            fontSize: level === 2 ? 16 : 14, 
                            color: level === 2 ? '#f093fb' : '#43e97b' 
                        }
                    };
                    
                    if(level < currentLevel.length) {
                        currentLevel[level - 1].children.push(node);
                    }
                    
                    currentLevel[level] = node;
                }
            }
            
            currentMindMap = root;
            renderMindMap();
            saveMindMapToSheet();
        }

        // Navigation functions
        function goBackToClasses() {
            document.getElementById('subjectSection').classList.add('hidden');
            document.querySelector('.brain-container').parentElement.style.display = 'flex';
        }

        function goBackToSubjects() {
            document.getElementById('topicSection').classList.add('hidden');
            document.getElementById('subjectSection').classList.remove('hidden');
        }

        function goBackToTopics() {
            document.getElementById('viewerSection').classList.add('hidden');
            document.getElementById('topicSection').classList.remove('hidden');
        }

        // Style toggle buttons
        document.getElementById('editBold').onclick = (e) => e.target.classList.toggle('active');
        document.getElementById('editItalic').onclick = (e) => e.target.classList.toggle('active');
        document.getElementById('editUnderline').onclick = (e) => e.target.classList.toggle('active');

        // Initialize
        window.onload = () => {
            initNeuralLines();
        };
    </script>
</body>
</html>
